generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PixKeyType {
  cpf
  cnpj
  email
  phone
  random
}

model SiteSetting {
  id      String @id @default("main")
  name    String @default("Pedro Lucena")
  tagline String @default("Saxofonista")
  city    String @default("São Paulo")

  email    String @default("")
  whatsapp String @default("")

  bioShort  String @default("") @db.Text
  bioMedium String @default("") @db.Text
  bioLong   String @default("") @db.Text

  heroImageUrl        String @default("")
  aboutImageUrl       String @default("")
  eventsImageUrl      String @default("")
  mentoriaImageUrl    String @default("")
  credentialsImageUrl String @default("")
  contactImageUrl     String @default("")
  resumeUrl           String @default("")

  instagramUrl String @default("")
  youtubeUrl   String @default("")
  tiktokUrl    String @default("")
  linkedinUrl  String @default("")
  spotifyUrl   String @default("")

  mentoriaDuration String @default("1h15")
  mentoriaPrice    String @default("")
  mentoriaText     String @default("") @db.Text
  eventsText       String @default("") @db.Text

  // Pix — editável pelo Pedro no painel, sem intervenção técnica
  pixKey     String     @default("")
  pixKeyType PixKeyType @default(email)
  pixName    String     @default("")
  pixCity    String     @default("SAO PAULO")

  updatedAt DateTime @updatedAt
}

enum CredentialGroup {
  formacao
  big_band
  temporada
  jazz_internacional
  pop_nacional
  festival
}

model Credential {
  id        String          @id @default(cuid())
  artist    String
  context   CredentialGroup
  year      String?
  note      String?
  sortOrder Int             @default(0)

  @@index([context, sortOrder])
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  subtitle    String  @default("")
  description String  @db.Text
  coverUrl    String  @default("")
  priceCents  Int
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  files     ProductFile[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([active, sortOrder])
}

model ProductFile {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  storageKey String
  sizeBytes  Int     @default(0)
  mimeType   String  @default("application/pdf")

  @@index([productId])
}

model Customer {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  phone           String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  savedCart       Json?
  orders          Order[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum TokenPurpose {
  magic_link
  password_reset
}

model CustomerLoginToken {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  email      String
  purpose    TokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([email])
}

enum OrderStatus {
  aguardando_pagamento
  pago
  entregue
  expirado
  cancelado
  reembolsado
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName  String
  customerEmail String
  customerPhone String  @default("")
  customerCpf   String?

  items      Json
  totalCents Int

  status     OrderStatus @default(aguardando_pagamento)
  pixPayload String?     @db.Text

  paidAt        DateTime?
  paidBy        String?
  downloadCount Int       @default(0)

  termsAcceptedAt DateTime?
  termsVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([customerId])
}

enum MessageKind {
  evento
  mentoria
  geral
}

model ContactMessage {
  id        String      @id @default(cuid())
  kind      MessageKind
  name      String
  email     String
  phone     String      @default("")
  payload   Json
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([readAt, createdAt])
}

model Show {
  id        String   @id @default(cuid())
  date      DateTime
  venue     String
  city      String
  url       String   @default("")
  createdAt DateTime @default(now())

  @@index([date])
}

model GalleryItem {
  id        String @id @default(cuid())
  url       String
  caption   String @default("")
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

enum MediaKind {
  video
  audio
}

/// Onde o vídeo aparece. Um vídeo de casamento não convence um aluno, e uma
/// transcrição de Mark Turner não fecha um evento corporativo — então cada
/// item é endereçado ao público que ele serve, em vez de tudo cair numa
/// página de mídia só.
enum MediaContext {
  eventos
  jazz
  estudo
}

model MediaItem {
  id        String       @id @default(cuid())
  kind      MediaKind
  context   MediaContext @default(jazz)
  url       String
  title     String
  /// Com quem, ou onde. "Edu Cristófaro e Léo Jaime", "Big Band Tom Jobim".
  credit    String       @default("")
  year      String       @default("")
  /// "3:55" — usado no cartão e no schema VideoObject.
  duration  String       @default("")
  /// Capa. Só para vídeo hospedado aqui — o do YouTube traz a sua.
  poster    String       @default("")
  featured  Boolean      @default(false)
  sortOrder Int          @default(0)

  @@index([kind, sortOrder])
  @@index([context, sortOrder])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
